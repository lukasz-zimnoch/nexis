# Required environment variables — no defaults. Each must be set to run
# `uvicorn nexis.server:app` locally. Optional variables (LangSmith tracing,
# FIREBASE_AUTH_DOMAIN override, etc.) and per-job overrides are documented
# in docs/specification.md §8.2.

OPENROUTER_API_KEY=    # routes all LLM calls through OpenRouter
TAVILY_API_KEY=        # Tavily web search API key
GCP_PROJECT_ID=        # GCP project; also used as the Firebase project ID
GCP_REGION=            # region of the Cloud Run Job (e.g., us-central1)
FIREBASE_API_KEY=      # Firebase Web SDK apiKey; served to the SPA via /config.json
