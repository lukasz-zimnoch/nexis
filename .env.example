OPENROUTER_API_KEY=    # required — routes all LLM calls through OpenRouter
TAVILY_API_KEY=
CHECKPOINT_DB=./nexis_dev.db
LANGCHAIN_TRACING_V2=false        # set to "true" to enable LangSmith tracing
LANGCHAIN_API_KEY=                # required if LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=nexis           # optional, defaults to "default"
